{
  "name": "nft",
  "detect_signals": [
    {
      "kind": "token_standardness",
      "value": "\\b(?:IERC721|ERC721|IERC1155|ERC1155)\\b",
      "weight": 3
    },
    {
      "kind": "access_control",
      "value": "\\b(?:safeTransferFrom|ownerOf|setApprovalForAll|mint|burn)\\s*\\(",
      "weight": 2
    },
    {
      "kind": "randomness",
      "value": "\\b(?:random|entropy|block\\.prevrandao|blockhash)\\b",
      "weight": 2
    },
    {
      "kind": "reentrancy_safety",
      "value": "\\b(?:onERC721Received|onERC1155Received|onERC1155BatchReceived)\\b",
      "weight": 1
    }
  ],
  "invariants": [
    "Token ownership and balances must reconcile after mint, transfer and burn.",
    "Receiver callbacks must preserve authorization and state-transition ordering.",
    "Randomized mint outcomes must not be predictable or selectively rerolled by an untrusted actor."
  ],
  "required_capabilities": [
    "control",
    "invariant-forge",
    "token-weird",
    "reprove",
    "trace-parity",
    "custody"
  ],
  "forbidden_capabilities": [],
  "attack_families": [
    "access",
    "callback",
    "reentrancy",
    "replay",
    "dos",
    "boundary",
    "erc20"
  ],
  "assumption_classes": [
    "token_standardness",
    "access_control",
    "randomness",
    "reentrancy_safety"
  ]
}
