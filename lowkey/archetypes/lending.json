{
  "name": "lending",
  "detect_signals": [
    {
      "kind": "oracle_trust",
      "value": "\\b(?:latestRoundData|latestAnswer|priceFeed|oracle|getAssetPrice)\\b",
      "weight": 3
    },
    {
      "kind": "precision",
      "value": "\\b(?:collateral|borrow|repay|totalDebt|borrowIndex|liquidationThreshold)\\b",
      "weight": 3
    },
    {
      "kind": "access_control",
      "value": "\\b(?:liquidate|borrow|withdrawCollateral|healthFactor)\\s*\\(",
      "weight": 2
    },
    {
      "kind": "time_dependence",
      "value": "\\b(?:block\\.timestamp|accrueInterest|borrowRate|lastUpdate)\\b",
      "weight": 1
    }
  ],
  "invariants": [
    "Account debt must reconcile with market debt and accrued interest.",
    "Collateral valuation and liquidation thresholds must use consistent units and valid prices.",
    "Repayment and liquidation must not leave unbacked debt or withdrawable collateral."
  ],
  "required_capabilities": [
    "control",
    "invariant-forge",
    "oracle-map",
    "economic",
    "reprove",
    "trace-parity",
    "flashmax"
  ],
  "forbidden_capabilities": [],
  "attack_families": [
    "accounting",
    "oracle",
    "economic",
    "boundary",
    "access",
    "dos"
  ],
  "assumption_classes": [
    "oracle_trust",
    "precision",
    "access_control",
    "time_dependence"
  ]
}
