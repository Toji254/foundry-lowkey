{
  "name": "staking",
  "detect_signals": [
    {
      "kind": "time_dependence",
      "value": "\\b(?:rewardPerToken|periodFinish|unlockTime|block\\.timestamp|vesting)\\b",
      "weight": 3
    },
    {
      "kind": "precision",
      "value": "\\b(?:stake|unstake|totalStaked|rewardRate|earned)\\b",
      "weight": 2
    },
    {
      "kind": "access_control",
      "value": "\\b(?:notifyRewardAmount|onlyOwner|pause|unpause)\\b",
      "weight": 1
    },
    {
      "kind": "external_call_safety",
      "value": "\\b(?:claim|withdraw|safeTransfer)\\s*\\(",
      "weight": 1
    }
  ],
  "invariants": [
    "Total user stake must reconcile with total staked assets.",
    "Rewards claimed must not exceed earned rewards after index and rounding updates.",
    "Lockups, cooldowns and vesting must use consistent time boundaries."
  ],
  "required_capabilities": [
    "control",
    "invariant-forge",
    "time",
    "economic",
    "reprove",
    "trace-parity"
  ],
  "forbidden_capabilities": [],
  "attack_families": [
    "accounting",
    "time",
    "boundary",
    "access",
    "reentrancy",
    "erc20"
  ],
  "assumption_classes": [
    "time_dependence",
    "precision",
    "access_control",
    "external_call_safety"
  ]
}
