#!/bin/bash
set -euo pipefail

# Native attack encyclopedia. Lookup is read-only; local lab instructions are
# rendered by the dedicated module and never use the active RPC or wallet.
if [[ "${1:-}" == "attack" || "${1:-}" == "attacks" ]]; then
    if [[ "${2:-}" == "forge" ]]; then
        shift 2
        exec python3 "$HOME/.lowkey/godmode.py" attack-forge "$@"
    fi
    shift
    exec python3 "$HOME/.lowkey/attack_library.py" "$@"
fi

# Teach the Solidity cheat catalogue to fingerprint source patterns.
if [[ "${1:-}" == "cheat" && "${2:-}" == "fingerprint" ]]; then
    shift 2
    exec python3 "$HOME/.lowkey/godmode.py" cheat-fingerprint "$@"
fi

# Integrated offensive-security workflows. Native commands not listed here
# continue through the original Lowkey router unchanged.
case "${1:-}" in
    capabilities|godmode|control|steps|mutation-score|target-coverage|provenance|fidelity|sandbox|decompile|storage-infer|proxy-resolve|selectors-full|cfg|reentrancy-graph|fallback-map|calldata-mine|attack-forge|invariant-forge|archetype|token-weird|oracle-map|skew|flashmax|time|sig-matrix|init-frontrun|path|compose|reprove|economic|gas-ladder|watch|custody|agent-split|verify-hack|unravel|bundle|sandwich|jit|fork-cache|upgrade-diff|cross-vm|learn|report|questions)
        exec python3 "$HOME/.lowkey/godmode.py" "$@"
        ;;
esac

# Preserve Lowkey's original function-level state-diff command. The
# Godmode storage-slot diff is selected only with explicit block/slot flags.
if [[ "${1:-}" == "state-diff" ]]; then
    use_slot_diff=0
    for arg in "$@"; do
        case "$arg" in
            --before|--before=*|--after|--after=*|--slot|--slot=*)
                use_slot_diff=1
                ;;
        esac
    done
    if [[ "$use_slot_diff" -eq 1 ]]; then
        exec python3 "$HOME/.lowkey/godmode.py" "$@"
    fi
fi

# "lk coverage" is the short alias for target-line coverage. It does not
# replace the existing audit pipeline coverage command.
if [[ "${1:-}" == "coverage" ]]; then
    shift
    exec python3 "$HOME/.lowkey/godmode.py" target-coverage "$@"
fi

# Native Forge subcommands must own their own --help parsing. The generic
# contextual-help interception below would otherwise turn 'lk forge debug --help'
# into Lowkey's help for an unknown nested command rather than Forge's real usage.
if [[ "${1:-}" == "forge" && "${2:-}" == "debug" ]]; then
    shift
    exec forge "$@"
fi

# Workspace overview and member selection. A plain project command is
# intercepted only at a workspace root; package-local project commands retain
# the original router and its selected-package behavior.
if [[ "${1:-}" == "project" && "$#" -eq 1 ]]; then
    if python3 "$HOME/.lowkey/workspace_tools.py" project; then
        exit 0
    else
        status=$?
        if [[ "$status" -ne 3 ]]; then
            exit "$status"
        fi
    fi
fi

if [[ "${1:-}" == "workspace" && ( "${2:-}" == "select" || "${2:-}" == "list" || "${2:-}" == "status" ) ]]; then
    shift
    exec python3 "$HOME/.lowkey/workspace_tools.py" "$@"
fi

# The Foundry build front door performs package selection and a read-only
# resource/config plan first. Non-Foundry projects fall back to the original
# repository-native build router rather than being forced through Forge.
if [[ "${1:-}" == "build" ]]; then
    shift
    exec python3 "$HOME/.lowkey/foundry_build.py" "$@"
fi

# Source risk is available before deployment. Live risk still uses the native
# router when a target exists or the user explicitly requests runtime mode.
if [[ "${1:-}" == "risk" ]]; then
    shift
    exec python3 "$HOME/.lowkey/source_risk.py" "$@"
fi

# Finding-scoped AI routes are opt-in and bounded. Ordinary AI commands keep
# their existing handler.
if [[ "${1:-}" == "ai" && "${2:-}" == "explain-finding" ]]; then
    shift 2
    exec python3 "$HOME/.lowkey/finding_explainer.py" explain-finding "$@"
fi
if [[ "${1:-}" == "ai" && "${2:-}" == "preview" ]]; then
    for arg in "${@:3}"; do
        case "$arg" in
            --finding|--finding=*)
                shift 2
                exec python3 "$HOME/.lowkey/finding_explainer.py" preview "$@"
                ;;
        esac
    done
fi
if [[ "${1:-}" == "ai" && "${2:-}" == "test-plan" ]]; then
    for arg in "${@:3}"; do
        case "$arg" in
            --finding|--finding=*)
                shift 2
                exec python3 "$HOME/.lowkey/finding_explainer.py" test-plan "$@"
                ;;
        esac
    done
fi

# Optional constrained reasoning; never used as a general chatbot.
if [[ "${1:-}" == "ai" ]]; then
    shift
    exec python3 "$HOME/.lowkey/ai_harness.py" "$@"
fi

# Native experience memory; this command works without AI configured.
if [[ "${1:-}" == "memory" ]]; then
    shift
    exec python3 "$HOME/.lowkey/experience_memory.py" "$@"
fi

for arg in "$@"; do
    case "$arg" in
        --h|--help|-h|help)
            exec python3 "$HOME/.lowkey/lk.py" "$@"
            ;;
    esac
done

if [[ "${1:-}" == "forge" ]]; then
    shift
    exec python3 "$HOME/.lowkey/forge_tools.py" "$@"
fi

if [[ "${1:-}" == "slither" ]]; then
    shift
    exec python3 "$HOME/.lowkey/slither_tools.py" "$@"
fi

if [[ "${1:-}" == "import" ]]; then
    shift
    exec python3 "$HOME/.lowkey/import_helper.py" "$@"
fi

case "${1:-}" in
    # Short alias for the native coverage wrapper. Keep the native subcommand
    # canonical so it receives the same arguments and behavior as "lk coverage".
    cov)
        # Friendly help must go through Lowkey's canonical coverage help page.
        for arg in "$@"; do
            case "$arg" in
                --h|--help|-h|help)
                    exec python3 "$HOME/.lowkey/lk.py" "$@"
                    ;;
            esac
        done
        shift
        exec python3 "$HOME/.lowkey/forge_tools.py" coverage "$@"
        ;;
    # Build is handled by the project-aware Foundry planner above, which
    # falls back to the repository-native adapter for non-Foundry projects.
    # Test remains on the original native project router.
    script|coverage|lint|geiger|fmt|lsp|create|verify-contract|verify-check|verify-bytecode|tree|install|remove|update|init|clean|cache|config|remappings|bind|bind-json|doc|compiler|eip712|soldeer|completions|flatten)
        # Friendly Lowkey help must be handled by the main router.
        for arg in "$@"; do
            case "$arg" in
                --h|--help|-h|help)
                    exec python3 "$HOME/.lowkey/lk.py" "$@"
                    ;;
            esac
        done
        exec python3 "$HOME/.lowkey/forge_tools.py" "$@"
        ;;
    generate)
        # Keep contextual help on the main Lowkey router; normal generation
        # still uses the dedicated generator entrypoint for a lean path.
        for arg in "$@"; do
            case "$arg" in
                --h|--help|-h|help)
                    exec python3 "$HOME/.lowkey/lk.py" "$@"
                    ;;
            esac
        done
        shift
        exec python3 "$HOME/.lowkey/generator.py" "${@}"
        ;;
    gen)
        # Short alias for generate; preserve the same native generator route.
        for arg in "$@"; do
            case "$arg" in
                --h|--help|-h|help)
                    exec python3 "$HOME/.lowkey/lk.py" "$@"
                    ;;
            esac
        done
        shift
        exec python3 "$HOME/.lowkey/generator.py" "${@}"
        ;;
esac

exec python3 "$HOME/.lowkey/lk.py" "$@"
