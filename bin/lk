#!/bin/bash
set -euo pipefail

# Compiler AST setup is explicit: it may edit foundry.toml and run a forced build.
if [[ "${1:-}" == "ast" ]]; then
    shift
    exec python3 "$HOME/.lowkey/foundry_ast_setup.py" "$@"
fi

# Hardhat has project-local binaries. Keep initialization and clean routing in
# one adapter; build/test continue through Lowkey's existing native planners.
if [[ "${1:-}" == "hardhat" ]]; then
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "hardhat" -- python3 "$HOME/.lowkey/hardhat_tools.py" "$@"
fi
if [[ "${1:-}" == "clean" ]]; then
    # Friendly Lowkey help must be handled before the Hardhat/Foundry clean
    # adapter; otherwise the short --h alias leaks through to the native CLI.
    for arg in "$@"; do
        case "$arg" in
            --h|--help|-h|help)
                exec python3 "$HOME/.lowkey/lk.py" "$@"
                ;;
        esac
    done
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "clean" -- python3 "$HOME/.lowkey/hardhat_tools.py" clean "$@"
fi

# One-command AI repair choice. The persistent choice is unchanged.
case "${1:-}" in
    build|test|walkthrough|walk|break|godmode|forge|report|deploy|test-gen)
        repair_override=""
        saw_guide=0
        saw_lazy=0
        repair_args=()
        for arg in "$@"; do
            case "$arg" in
                --guide) repair_override="guide"; saw_guide=1 ;;
                --lazy) repair_override="lazy"; saw_lazy=1 ;;
                *) repair_args+=("$arg") ;;
            esac
        done
        if [[ "$saw_guide" -eq 1 && "$saw_lazy" -eq 1 ]]; then
            echo "Choose either --guide or --lazy, not both." >&2
            exit 2
        fi
        if [[ -n "$repair_override" ]]; then
            export LOWKEY_REPAIR_MODE_OVERRIDE="$repair_override"
            set -- "${repair_args[@]}"
        fi
        ;;
esac

# Native attack encyclopedia. Lookup is read-only; local lab instructions are
# rendered by the dedicated module and never use the active RPC or wallet.
if [[ "${1:-}" == "attack" || "${1:-}" == "attacks" ]]; then
    case "${2:-}" in
        research)
            shift 2
            exec python3 "$HOME/.lowkey/command_wrapper.py" "attack" -- python3 "$HOME/.lowkey/attack_research.py" "$@"
            ;;
        synthesize)
            shift 2
            exec python3 "$HOME/.lowkey/command_wrapper.py" "attack" -- python3 "$HOME/.lowkey/attack_synthesis.py" "$@"
            ;;
        engines|discover|verify|chain)
            shift
            exec python3 "$HOME/.lowkey/command_wrapper.py" "attack" -- python3 "$HOME/.lowkey/attack_engine.py" "$@"
            ;;
        forge)
            shift 2
            exec python3 "$HOME/.lowkey/command_wrapper.py" "attack" -- python3 "$HOME/.lowkey/godmode.py" attack-forge "$@"
            ;;
    esac
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "attack" -- python3 "$HOME/.lowkey/attack_library.py" "$@"
fi

# Teach the Solidity cheat catalogue to fingerprint source patterns.
if [[ "${1:-}" == "cheat" && "${2:-}" == "fingerprint" ]]; then
    shift 2
    exec python3 "$HOME/.lowkey/command_wrapper.py" "cheat" -- python3 "$HOME/.lowkey/godmode.py" cheat-fingerprint "$@"
fi

# Root help includes the evidence-first Godmode command catalogue as a second section.
# Keep the primary Lowkey help output unchanged, then append the installed Godmode index.
if [[ "$#" -eq 1 ]]; then
    case "${1:-}" in
        --h|--help|-h|help)
            python3 "$HOME/.lowkey/lk.py" "$@"
            python3 "$HOME/.lowkey/godmode.py"
            cat <<'LOWKEY_SOURCE_HELP'

Compiler AST evidence:
  lk ast doctor              Read-only compiler AST readiness check
  lk ast setup               Enable AST/build-info, rebuild and verify

Hardhat project setup:
  lk hardhat init
  lk hardhat doctor           Read-only Hardhat readiness report
  lk build
  lk test
  lk clean

Source relationship navigation:
  lk link                       Browse available contracts and source locations
  lk link --help                 Full flags, use cases and copy-paste examples
  lk trace source --help         Source-call traversal, detail views and depth options
  lk fn --flow --help            Incoming/outgoing asset-flow filter guide
  lk link Vault
  lk link Vault.withdraw
  lk link Vault.positions
  lk link 'Vault.withdraw(uint256)' --depth 3
  lk trace source Vault.withdraw
  lk trace source 'Vault.withdraw(uint256)' --depth 5
  lk link Vault --only calls|storage|reads|writes|imports|assets
  lk fn --flow in|out|both --asset eth|erc20|all
  lk flow eth                  Map native ETH ingress, call paths and exit attempts
  lk flow eth --h               Explain ETH-flow recon and its evidence limits

Static links describe source relationships, not proof that a path executed.
Use lk trace to investigate actual transaction execution.
LOWKEY_SOURCE_HELP
            exit 0
            ;;
    esac
fi

# Integrated offensive-security workflows. Native commands not listed here
# continue through the original Lowkey router unchanged.
case "${1:-}" in
    capabilities|godmode|control|trace-parity|steps|mutation-score|target-coverage|provenance|fidelity|sandbox|cheat-fingerprint|decompile|storage-infer|proxy-resolve|selectors-full|cfg|reentrancy-graph|fallback-map|calldata-mine|attack-forge|invariant-forge|archetype|assumptions|capability|token-weird|oracle-map|skew|flashmax|time|sig-matrix|init-frontrun|path|compose|reprove|economic|gas-ladder|watch|custody|agent-split|verify-hack|unravel|bundle|sandwich|jit|fork-cache|upgrade-diff|cross-vm|learn|report|questions)
        exec python3 "$HOME/.lowkey/command_wrapper.py" "$1" -- python3 "$HOME/.lowkey/godmode.py" "$@"
        ;;
esac

# Preserve Lowkey's original function-level state-diff command. The
# Godmode storage-slot diff is selected only with explicit block/slot flags.
if [[ "${1:-}" == "state-diff" ]]; then
    use_slot_diff=0
    for arg in "$@"; do
        case "$arg" in
            --before|--before=*|--after|--after=*|--slot|--slot=*)
                use_slot_diff=1
                ;;
        esac
    done
    if [[ "$use_slot_diff" -eq 1 ]]; then
        exec python3 "$HOME/.lowkey/command_wrapper.py" "state-diff" -- python3 "$HOME/.lowkey/godmode.py" "$@"
    fi
fi

# Read-only EVM block/header inspection is protocol-agnostic and does not
# require a selected contract target or ABI.
if [[ "${1:-}" == "block" || "${1:-}" == "blocks" ]]; then
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "block" -- python3 "$HOME/.lowkey/block_tools.py" "$@"
fi

# "lk coverage" is the short alias for target-line coverage. It does not
# replace the existing audit pipeline coverage command.
if [[ "${1:-}" == "coverage" ]]; then
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "coverage" -- python3 "$HOME/.lowkey/godmode.py" target-coverage "$@"
fi

# Native Forge subcommands must own their own --help parsing. The generic
# contextual-help interception below would otherwise turn 'lk forge debug --help'
# into Lowkey's help for an unknown nested command rather than Forge's real usage.
if [[ "${1:-}" == "forge" && "${2:-}" == "debug" ]]; then
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "forge" -- forge "$@"
fi

# Workspace overview and member selection. A plain project command is
# intercepted only at a workspace root; package-local project commands retain
# the original router and its selected-package behavior.
if [[ "${1:-}" == "project" && "$#" -eq 1 ]]; then
    if python3 "$HOME/.lowkey/command_wrapper.py" project --skip-status 3 -- python3 "$HOME/.lowkey/workspace_tools.py" project; then
        exit 0
    else
        status=$?
        if [[ "$status" -ne 3 ]]; then
            exit "$status"
        fi
    fi
fi

if [[ "${1:-}" == "workspace" && ( "${2:-}" == "select" || "${2:-}" == "list" || "${2:-}" == "status" ) ]]; then
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "workspace" -- python3 "$HOME/.lowkey/workspace_tools.py" "$@"
fi

# Project-scoped audit workflow, reusing the evidence journal and q engine.
if [[ "${1:-}" == "workflow" ]]; then
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "workflow" -- python3 "$HOME/.lowkey/workflow_engine.py" "$@"
fi

# The Foundry build front door performs package selection and a read-only
# resource/config plan first. Non-Foundry projects fall back to the original
# repository-native build router rather than being forced through Forge.
if [[ "${1:-}" == "build" ]]; then
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "build" -- python3 "$HOME/.lowkey/foundry_build.py" "$@"
fi

# Source risk is available before deployment. Live risk still uses the native
# router when a target exists or the user explicitly requests runtime mode.
if [[ "${1:-}" == "risk" ]]; then
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "risk" -- python3 "$HOME/.lowkey/source_risk.py" "$@"
fi

# Finding-scoped AI routes are opt-in and bounded. Ordinary AI commands keep
# their existing handler.
if [[ "${1:-}" == "ai" && "${2:-}" == "explain-finding" ]]; then
    shift 2
    exec python3 "$HOME/.lowkey/command_wrapper.py" "ai" -- python3 "$HOME/.lowkey/finding_explainer.py" explain-finding "$@"
fi
if [[ "${1:-}" == "ai" && "${2:-}" == "preview" ]]; then
    for arg in "${@:3}"; do
        case "$arg" in
            --finding|--finding=*)
                shift 2
                exec python3 "$HOME/.lowkey/command_wrapper.py" "ai" -- python3 "$HOME/.lowkey/finding_explainer.py" preview "$@"
                ;;
        esac
    done
fi
if [[ "${1:-}" == "ai" && "${2:-}" == "test-plan" ]]; then
    for arg in "${@:3}"; do
        case "$arg" in
            --finding|--finding=*)
                shift 2
                exec python3 "$HOME/.lowkey/command_wrapper.py" "ai" -- python3 "$HOME/.lowkey/finding_explainer.py" test-plan "$@"
                ;;
        esac
    done
fi

# Optional constrained reasoning; never used as a general chatbot.
if [[ "${1:-}" == "ai" ]]; then
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "ai" -- python3 "$HOME/.lowkey/ai_harness.py" "$@"
fi

# Native ETH-flow reconnaissance uses the shared source relationship index.
# It is read-only and follows declared cross-contract calls without claiming that
# the implementation behind a runtime address is proven.
if [[ "${1:-}" == "flow" && "${2:-}" == "eth" ]]; then
    shift 2
    exec python3 "$HOME/.lowkey/command_wrapper.py" "flow" -- python3 "$HOME/.lowkey/eth_flow.py" "$@"
fi

# Static source tracing is separate from runtime transaction tracing.
# "lk trace source ..." walks source-level calls/effects; ordinary "lk trace TX"
# continues to use the existing runtime trace handler.
if [[ "${1:-}" == "trace" && "${2:-}" == "source" ]]; then
    shift 2
    exec python3 "$HOME/.lowkey/command_wrapper.py" "trace" -- python3 "$HOME/.lowkey/source_link.py" trace source "$@"
fi

# Source navigation and the new asset-flow filters share one source index.
# Ordinary lk fn, lk trace, and all existing routes keep their current handlers.
if [[ "${1:-}" == "link" ]]; then
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "link" -- python3 "$HOME/.lowkey/source_link.py" link "$@"
fi
# Verbose function inventories rely on compiler AST evidence. Diagnose missing
# Foundry output without silently editing project configuration or rebuilding.
if [[ "${1:-}" == "fn" ]]; then
    verbose_requested=0
    for arg in "$@"; do
        case "$arg" in
            -v|--verbose) verbose_requested=1 ;;
        esac
    done
    if [[ "$verbose_requested" -eq 1 && -f "$HOME/.lowkey/foundry_ast_setup.py" ]] && command -v forge >/dev/null 2>&1; then
        python3 "$HOME/.lowkey/foundry_ast_setup.py" doctor --quiet-if-ready || true
    fi
fi

if [[ "${1:-}" == "fn" ]]; then
    for arg in "$@"; do
        case "$arg" in
            --flow|--flow=*)
                shift
                exec python3 "$HOME/.lowkey/command_wrapper.py" "fn" -- python3 "$HOME/.lowkey/source_link.py" flow "$@"
                ;;
        esac
    done
fi

# Native experience memory; this command works without AI configured.
if [[ "${1:-}" == "memory" ]]; then
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "memory" -- python3 "$HOME/.lowkey/experience_memory.py" "$@"
fi

for arg in "$@"; do
    case "$arg" in
        --h|--help|-h|help)
            exec python3 "$HOME/.lowkey/lk.py" "$@"
            ;;
    esac
done

# A Hardhat test may be the first project command. Prepare its declared local
# dependencies before handing execution back to the existing native LK router.
# Exit 3 means "not a Hardhat project" and preserves the old routing unchanged.
if [[ "${1:-}" == "test" ]]; then
    if python3 "$HOME/.lowkey/hardhat_tools.py" prepare; then
        exec python3 "$HOME/.lowkey/lk.py" "$@"
    else
        status=$?
        if [[ "$status" -ne 3 ]]; then
            exit "$status"
        fi
    fi
    exec python3 "$HOME/.lowkey/lk.py" "$@"
fi

if [[ "${1:-}" == "forge" ]]; then
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "forge" -- python3 "$HOME/.lowkey/forge_tools.py" "$@"
fi

if [[ "${1:-}" == "slither" ]]; then
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "slither" -- python3 "$HOME/.lowkey/slither_tools.py" "$@"
fi

if [[ "${1:-}" == "import" ]]; then
    shift
    exec python3 "$HOME/.lowkey/command_wrapper.py" "import" -- python3 "$HOME/.lowkey/import_helper.py" "$@"
fi

case "${1:-}" in
    # Short alias for the native coverage wrapper. Keep the native subcommand
    # canonical so it receives the same arguments and behavior as "lk coverage".
    cov)
        # Friendly help must go through Lowkey's canonical coverage help page.
        for arg in "$@"; do
            case "$arg" in
                --h|--help|-h|help)
                    exec python3 "$HOME/.lowkey/lk.py" "$@"
                    ;;
            esac
        done
        shift
        exec python3 "$HOME/.lowkey/command_wrapper.py" "coverage" -- python3 "$HOME/.lowkey/forge_tools.py" coverage "$@"
        ;;
    # Build is handled by the project-aware Foundry planner above, which
    # falls back to the repository-native adapter for non-Foundry projects.
    # Test remains on the original native project router.
    script|coverage|lint|geiger|fmt|lsp|create|verify-contract|verify-check|verify-bytecode|tree|install|remove|update|init|clean|cache|config|remappings|bind|bind-json|doc|compiler|eip712|soldeer|completions|flatten)
        # Friendly Lowkey help must be handled by the main router.
        for arg in "$@"; do
            case "$arg" in
                --h|--help|-h|help)
                    exec python3 "$HOME/.lowkey/lk.py" "$@"
                    ;;
            esac
        done
        exec python3 "$HOME/.lowkey/command_wrapper.py" "$1" -- python3 "$HOME/.lowkey/forge_tools.py" "$@"
        ;;
    generate)
        # Keep contextual help on the main Lowkey router; normal generation
        # still uses the dedicated generator entrypoint for a lean path.
        for arg in "$@"; do
            case "$arg" in
                --h|--help|-h|help)
                    exec python3 "$HOME/.lowkey/lk.py" "$@"
                    ;;
            esac
        done
        shift
        exec python3 "$HOME/.lowkey/command_wrapper.py" "generate" -- python3 "$HOME/.lowkey/generator.py" "${@}"
        ;;
    gen)
        # Short alias for generate; preserve the same native generator route.
        for arg in "$@"; do
            case "$arg" in
                --h|--help|-h|help)
                    exec python3 "$HOME/.lowkey/lk.py" "$@"
                    ;;
            esac
        done
        shift
        exec python3 "$HOME/.lowkey/command_wrapper.py" "gen" -- python3 "$HOME/.lowkey/generator.py" "${@}"
        ;;
esac

exec python3 "$HOME/.lowkey/lk.py" "$@"
