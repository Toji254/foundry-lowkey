#!/bin/bash
set -euo pipefail

if [[ "${1:-}" == "forge" ]]; then
    shift
    exec python3 "$HOME/.lowkey/forge_tools.py" "$@"
fi

if [[ "${1:-}" == "slither" ]]; then
    shift
    exec python3 "$HOME/.lowkey/slither_tools.py" "$@"
fi

case "${1:-}" in
    build|test|script|inspect|coverage|lint|geiger|fmt|clone|lsp)
        exec python3 "$HOME/.lowkey/forge_tools.py" "$@"
        ;;
    generate)
        shift
        exec python3 "$HOME/.lowkey/generator.py" "${@}"
        ;;
esac

exec python3 "$HOME/.lowkey/lk.py" "$@"
